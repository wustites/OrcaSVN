{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrcaSVN",
  "version": "0.6.5-rc.3",
  "identifier": "com.orcasvn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OrcaSVN",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "devtools": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "postInstallScript": "installer/linux-postinst.sh",
        "postRemoveScript": "installer/linux-postrm.sh"
      },
      "rpm": {
        "postInstallScript": "installer/linux-postinst.sh",
        "postRemoveScript": "installer/linux-postrm.sh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
